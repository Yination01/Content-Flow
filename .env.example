# ContentFlow Environment Variables Template
# Copy to .env.local for local development. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Bootstrap (Bootstrap only; runtime authz uses server-managed user_roles table)
SUPERUSER_EMAIL=

# Paystack Billing (Server-side secret + public key)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cloudflare Workers AI & R2 Storage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face Fallback (Optional, Server-only)
HUGGINGFACE_API_KEY=

# YouTube OAuth & Data API
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok OAuth & Publishing API
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
