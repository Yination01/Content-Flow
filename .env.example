# ============================================================================
# ContentFlow — $0.00/Month Free-Tier Production Environment Variables
# Copy to `.env.local` for local overrides or add to Vercel Project Settings.
# When omitted locally, ContentFlow runs with built-in disk persistence
# (.data/contentflow-db.json) and zero-cost built-in generators.
# ============================================================================

# 1. Authentication & Security Secrets (Generate with: openssl rand -hex 32)
AUTH_SESSION_SECRET=replace-with-32-byte-hex-session-secret
ENVELOPE_MASTER_SECRET=replace-with-32-byte-hex-aes-256-gcm-master-secret

# 2. Supabase Free Tier (Database, Auth, RLS & pg_cron) — $0/month
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Cloudflare Workers AI & R2 Object Storage Free Tier — $0/month
# Guardrails hard-stop at 8,000 Neurons/day (vs 10k free) & 800k R2 ops/month (vs 1M free)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-s3-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-s3-secret-access-key
R2_BUCKET_NAME=contentflow-media

# 4. Hugging Face Inference API Free Tier (Plan C Fallback) — $0/month
HUGGINGFACE_API_KEY=hf_your_free_inference_token

# 5. Social Publishing OAuth 2.0 PKCE (YouTube Data API v3 & TikTok Content Posting API) — $0/month
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_REDIRECT_URI=https://your-domain.vercel.app/api/v1/platforms/callback
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_REDIRECT_URI=https://your-domain.vercel.app/api/v1/platforms/callback

# 6. Paystack Payments ($0 monthly fee; pay-as-you-go only on successful revenue)
PAYSTACK_SECRET_KEY=sk_test_or_live_paystack_secret_key
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
